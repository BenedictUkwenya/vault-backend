# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Stripe (use sk_test_... / pk_test_... for sandbox)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MEMBER_PRICE_ID=price_...
STRIPE_STUDENT_PRICE_ID=price_...
STRIPE_VIP_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Where Supabase invite links land after the user sets a password (marketing site or admin)
NETWORK_INVITE_REDIRECT_URL=https://www.blacklimitless.com
# Comma-separated list of allowed browser origins (admin panel, web app, network site, etc.)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,https://www.blacklimitless.com,https://blacklimitless.com
APP_NAME=Black Limitless
REFERRALS_FOR_FREE_MONTH=5
